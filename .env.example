# --- Порти, відкриті на хості ---
BACKEND_PORT=3000
FRONTEND_PORT=5173
NGINX_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Mailpit (лише dev): веб-інтерфейс листів і SMTP ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- PostgreSQL ---
POSTGRES_USER=postgre
POSTGRES_PASSWORD=root
POSTGRES_DB=postgre

# --- Redis ---
REDIS_PASSWORD=

# --- CAPTCHA (Cloudflare Turnstile), публічний site key ---
# Парний секретний ключ — TURNSTILE_SECRET_KEY у backend/.env. Для prod ключ
# вшивається в бандл на етапі збірки (build arg). Порожній ключ = віджет не
# показується; тоді на бекенді має бути CAPTCHA_ENABLED=false.
VITE_TURNSTILE_SITE_KEY=

# --- Ціль збірки ---
NODE_ENV=development
