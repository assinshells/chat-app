PORT=3000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgre:root@localhost:5432/postgre
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# Генерувати так: openssl rand -hex 64 (свій секрет для кожного з двох)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# У секундах, має відповідати JWT_REFRESH_EXPIRES_IN (TTL запису в Redis)
JWT_REFRESH_TTL_SECONDS=604800

# Час життя коду (3 хв). Фронтенд показує таймер на ті самі 180 секунд.
OTP_TTL_SECONDS=180
# Час, протягом якого після введення коду можна встановити новий пароль
OTP_VERIFIED_TTL_SECONDS=600
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_OTP_MAX=10
RATE_LIMIT_RESET_MAX=5
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_WINDOW_MS=900000

# --- Єдиний потік "вхід -> завершення реєстрації" ---
# Скільки живе тимчасова реєстраційна сесія (між "Увійти" і "В чат"), с.
# У ній лежить лише логін і хеш пароля; користувача в БД ще немає.
REGISTRATION_SESSION_TTL_SECONDS=900
# Скільки реєстраційних сесій можна стартувати з однієї IP за вікно.
REGISTRATION_START_MAX_PER_IP=10
REGISTRATION_START_WINDOW_SECONDS=900
# Ліміт невдалих входів по самому логіну (захист від розподіленого
# перебору пароля з багатьох IP), вікно в секундах.
LOGIN_FAIL_MAX=10
LOGIN_FAIL_WINDOW_SECONDS=900

# Скільки reverse-proxy стоїть перед бекендом (nginx у docker/prod = 1).
# Порожньо: у production = 1, інакше вимкнено. Невірне значення дозволяє
# підміняти IP через X-Forwarded-For і обходити IP-ліміти.
TRUST_PROXY=

# --- CAPTCHA (Cloudflare Turnstile) на кроці "В чат" ---
# За замовчуванням: увімкнена в production, вимкнена в development.
# Якщо CAPTCHA_ENABLED=true, а TURNSTILE_SECRET_KEY порожній — бекенд не
# запуститься. Секретний ключ — лише тут, на бекенді; публічний site key
# для фронтенду — VITE_TURNSTILE_SITE_KEY (див. кореневий .env.example).
# Ключі: https://dash.cloudflare.com/?to=/:account/turnstile
CAPTCHA_ENABLED=
TURNSTILE_SECRET_KEY=
# Необов'язково: приймати лише токени, видані для цього hostname.
TURNSTILE_EXPECTED_HOSTNAME=
CAPTCHA_TIMEOUT_MS=5000

# --- SMTP (nodemailer) ---
# Локально (без Docker) з Mailpit: SMTP_HOST=localhost, SMTP_PORT=1025,
# листи видно на http://localhost:8025. У docker/dev/compose.yml ці
# значення вже виставлені (SMTP_HOST=mailpit).
# Без SMTP_HOST листи не надсилаються: у development код просто пишеться в лог,
# у production відправка завершиться помилкою.
SMTP_HOST=
SMTP_PORT=587
# true для порту 465 (неявний TLS), false для 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Балачка <no-reply@example.com>"

# Дефолтний суперадмін — заводиться/оновлюється автоматично при кожному
# старті бекенда (тільки роль, пароль існуючого користувача не чіпається).
# Обов'язково змініть логін/пароль перед деплоєм у будь-яке відкрите оточення.
SUPERADMIN_LOGIN=superadmin
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_EMAIL=
# Вікторина (кімната "Головна", команда !викторина)
# QUIZ_ANSWER_TIME_SECONDS=25
# QUIZ_COOLDOWN_MINUTES=10
